Private/
Secret_data/
*.ini
# =====================================
# 🗂️ Obsidian Vault 最適化用
# =====================================

# --------------------------
# Windows システムファイル
# --------------------------
desktop.ini
Thumbs.db
ehthumbs.db

# --------------------------
# macOS システムファイル
# --------------------------
.DS_Store

# --------------------------
# Obsidian プラグインの一時ファイル
# （必要に応じて除外）
# --------------------------
.obsidian/workspace
.obsidian/cache
.obsidian/plugins/**/node_modules/

# --------------------------
# ログ & ビルド
# --------------------------
logs/
*.log

# --------------------------
# Python / Rust / Node 等ビルドキャッシュ
# --------------------------
__pycache__/
*.pyc
target/
node_modules/

# --------------------------
# バックアップファイル（~など）
# --------------------------
*~
*.bak
*.swp

# --------------------------
# OS が自動生成するファイル全般
# --------------------------
$RECYCLE.BIN/
System Volume Information/

# --------------------------
# Obsidian Publish に使わないメモ群（例）
# --------------------------
# [Private]/
# [Drafts]/
