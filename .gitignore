# ===============================
# 機密情報・プライベートファイル
# ===============================
Private/
Secret_data/
*極秘* # 「極秘」を含むファイル/フォルダを無視
*.ini

# ===============================
# Obsidian Vault 用 GitIgnore
# ===============================

# OSゴミ
.DS_Store
Thumbs.db

# Obsidianのキャッシュ類
.obsidian/workspace.json
.obsidian/appearance.json
.obsidian/graph.json
.obsidian/workspace.mobile.json

# Attachments フォルダ（必要なら管理する）
# ![Attachments]/

# ゴミファイル
*.tmp
*.swp

# ローカル専用下書きなど
Drafts/
Logs/
*.log
[Paramount]Workflow/LSC-TCP/

# Git自体の設定
*.lock
 
# ===============================
# 追加: 一時・キャッシュ・ゴミ箱など
# ===============================

# OS由来の不要ファイル（重複OK）
.DS_Store
Thumbs.db
desktop.ini

# 一時・バックアップ（vim/エディタ/ツール）
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~

# Python キャッシュ
__pycache__/
*.pyc
*.pyo

# Obsidian キャッシュ・ゴミ箱
.obsidian/cache/
.trash/

# ファイル名・フォルダ名に「極秘」を含むもの全てを除外
# 例: 『極秘計画.md』『docs/案件_極秘/…』
*極秘*

# ===============================
# 実行ファイル・スクリプトの除外
# ===============================
# PowerShell
*.ps1
*.psm1
*.psd1
# Windows shell
*.bat
*.cmd
# POSIX shells
*.sh
*.bash
*.zsh
*.ksh
*.fish
# Windows Script Host
*.vbs
*.wsf
# Scripting languages
*.py
*.rb
*.pl
*.pm
*.php
*.cgi
*.lua
*.r
# JS/TS
*.js
*.ts
*.mjs
*.cjs
# Bytecode/WASM
*.jar
*.class
*.wasm
# Binaries
*.exe
*.com
*.msi
*.dll

# Gemini specific
.gpt_reminder
