%% Architecture Document - Network Diagram
graph TD
    subgraph External Systems [外部システム]
        A[決済事業者 / ベンダー]
        B["E-20準拠<br/>ステーブルコインネットワーク<br/>Polygon・Ethereum L2 等"]
    end

    subgraph THP_CLEAR_Network [THP-CLEAR ネットワーク]
        direction LR
        subgraph MQ_Cluster["G1: MQノードクラスタ（20台）"]
            MQ1(MQ-01)
            MQ2(MQ-02)
            MQ3(MQ-03)
        end

        subgraph WN_Cluster["G2: WNノードクラスタ（60台）"]
            WN1(WN-01)
            WN2(WN-02)
            WN_etc(WN-etc)
        end

        subgraph DB_Cluster["G3: DBノードクラスタ（20台）"]
            DB1(DB-01)
            DB2(DB-02)
            DB_etc(DB-etc)
        end

        subgraph KMS_Cluster["KMS Ring（3台以上／quorum=2）<br/>独立クラスタ（MQとは別プロセス）"]
            KMS1(KMS-01)
            KMS2(KMS-02)
            KMS3(KMS-03)
        end
        
        subgraph Monitoring["監視・監査"]
            Metrics["Prometheus<br/>/metrics"]
            Logs["Audit Logs<br/>(JSONL)"]
        end
    end

    %% Data Flow
    A -- "1. 決済ログを通知" --> MQ_Cluster;
    B -- "Transferイベント" --> WN_Cluster;
    MQ_Cluster -- "2. 検証タスクをキューイング" --> WN_Cluster;
    WN_Cluster -- "3. イベントとログを突合" --> B;
    WN_Cluster -- "4. Witnessログ生成" --> DB_Cluster;
    DB_Cluster -- "5. ログを永続化" --> Storage((WORM Storage));

    %% Security & Management Flow
    MQ_Cluster <--> |鍵要求・認証| KMS_Cluster;
    WN_Cluster <--> |鍵要求・認証| KMS_Cluster;
    DB_Cluster <--> |鍵要求・認証| KMS_Cluster;
    KMS_Cluster -- SPY_ALERT --> MQ_Cluster;
    KMS_Cluster -- SPY_ALERT --> WN_Cluster;
    KMS_Cluster -- SPY_ALERT --> DB_Cluster;

    %% Monitoring Flow
    MQ_Cluster -- "メトリクス/ログ" --> Monitoring;
    WN_Cluster -- "メトリクス/ログ" --> Monitoring;
    DB_Cluster -- "メトリクス/ログ" --> Monitoring;
    KMS_Cluster -- "メトリクス/ログ" --> Monitoring;

    classDef default fill:#fff,stroke:#333,stroke-width:2px;
    classDef cluster fill:#f9f9f9,stroke:#ccc,stroke-width:2px,rx:10,ry:10;
    class MQ_Cluster,WN_Cluster,DB_Cluster,KMS_Cluster,Monitoring cluster;
