%% Integrated Proposal - Policy View
graph TD
  %% Governance / Policy
  G0["政府・関係省庁（内閣官房/総務/経産/財務）"]
  G1["決済事業者（SMBC / Google Pay / Apple Pay / 他）"]
  G2["既存通貨に基づくステーブルコイン（例：JPYC）<br/>※フィアット完全準拠"]

  %% CLEAR Core
  subgraph CORE["THP-CLEAR Core（東西DC：Active-Active）"]
    direction LR
    KMS["KMS Ring（3+ / quorum=2）<br/>Challenge→Submit セッション固定"]
    MQ["MQ Cluster（Raft / Ordering）"]
    WN["Witness Nodes（非同期 append / ローテ）"]
    DB["DB Nodes（Materialized / SQLite / RAID1 4TB×2）"]
    MET["Prometheus / Grafana（Ops-KPI / E-MAD連携）"]
    KMS-->MQ-->WN-->DB-->MET
  end

  %% Edge / Municipal
  subgraph EDGE["自治体ネット（市役所等：分散配置）"]
    direction TB
    W1["Regional Witness（AES-NI / NVMe / RAM 4GB）"]
    W2["Fallback（学校/消防/病院）"]
  end

  %% AI / Audit
  subgraph AI["AI連携（オンプレ可：Ricoh-AI 等）"]
    A1["AI Decision Engine（審査/検品/不正検知）"]
    A2["AI監査インターフェース（mTLS）"]
  end

  %% Flows
  G1-- "決済依頼（バーチャルデビット/トークン認証）" -->G2
  G2-- "Txイベント（When/Who/Whom/Coin/Value）" -->EDGE
  EDGE-- "Witnessログ送信（非同期）" -->CORE
  CORE-- "整合証跡（Merkle Root / 署名）" -->G0
  AI-- "AI結果の監査証跡付与" -->CORE
  G0-- "方針・KPI（E-MAD）" -->MET
